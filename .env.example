# api/chat.js picks its AI provider based on which of these two is set — GEMINI_API_KEY is
# checked first. To switch providers, change which key is set in Vercel; no code change needed.
#
# Get a free-tier Gemini key at https://aistudio.google.com/apikey (currently the active
# provider, since it has a usable free tier — see api/_lib/gemini.js).
GEMINI_API_KEY=
# Optional — overrides the default Gemini model (see api/_lib/gemini.js) if it's ever retired.
GEMINI_MODEL=
# Get an Anthropic key at https://console.anthropic.com/settings/keys. Leave unset while
# GEMINI_API_KEY is set — it's only used as a fallback (see api/chat.js) when Gemini isn't
# configured, so this app never depends on having both.
#
# Never commit a real key to this file or anywhere in the repo — set these in Vercel's Project
# Settings -> Environment Variables instead.
ANTHROPIC_API_KEY=

# Required by src/supabaseClient.js. VITE_-prefixed vars are inlined into the
# client bundle at build time (see vite.config.js docs) — this is expected
# here: the publishable/anon key is meant to be public, and every table it
# can reach is protected by row-level security (see supabase/schema.sql),
# not by keeping this key secret. Find these under your Supabase project's
# Settings -> API. Set them in Vercel's Environment Variables too, since
# they're needed at build time, not just runtime.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Required by api/_lib/google.js (used by every api/google|gmail|calendar/* function). This is
# the SAME project as above, but a plain (non-VITE_) var: these run as Vercel serverless/edge
# functions, not through Vite, so Vite's client-bundling rules don't apply and this value is
# never sent to the browser.
SUPABASE_URL=
# The service_role key, NOT the anon/publishable key above — find it on the same Settings ->
# API page, under a "reveal" toggle since Supabase treats it as sensitive. It bypasses row-level
# security entirely, which is exactly what these functions need to read/write oauth_tokens (a
# table with no RLS policies for anon/authenticated — see supabase/schema.sql). Never expose
# this key to the client, never commit it, never prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Required for the Gmail / Google Calendar integration (api/google/*, api/gmail/*,
# api/calendar/*). Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials, with an authorized redirect URI of
# <your deployed URL>/api/google/callback (e.g. https://kroft.vercel.app/api/google/callback —
# add one entry per domain you deploy to, including any Vercel preview domains you test with).
# You'll also need to enable the Gmail API and Google Calendar API for the project, and add the
# scopes listed in api/_lib/google.js (GOOGLE_SCOPES) on the OAuth consent screen. Sensitive
# scopes like Gmail read/send require Google's app verification review before anyone besides
# you (as a test user on the consent screen) can use them — expect that to take some time.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string — used to sign the OAuth state parameter (see api/_lib/oauthState.js,
# shared by both Google's and Microsoft's OAuth flows below) so the callback can trust which
# user initiated the connection. Generate one with, e.g.:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
OAUTH_STATE_SECRET=

# Required for the Outlook Mail / Outlook Calendar integration (api/microsoft/*, folded into
# api/mail/* and api/calendar/* alongside Google). Register an app at
# https://portal.azure.com -> Microsoft Entra ID -> App registrations -> New registration.
# - Supported account types: "Accounts in any organizational directory and personal Microsoft
#   accounts" (matches the "common" tenant this app authenticates against).
# - Add a redirect URI (platform: Web) of <your deployed URL>/api/microsoft/callback — one
#   entry per domain you deploy to, including any Vercel preview domains you test with.
# - Under API permissions, add the delegated Microsoft Graph scopes: Mail.Read, Mail.Send,
#   Calendars.ReadWrite, User.Read, offline_access (see api/_lib/microsoft.js's
#   MICROSOFT_SCOPES). Mail/Calendar scopes may need admin consent depending on your tenant
#   settings for a work/school account signing in — personal Microsoft accounts don't need this.
# - Under Certificates & secrets, create a new client secret — that's MICROSOFT_CLIENT_SECRET.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Required for real KROFT Plus billing (api/billing/*). Uses Flutterwave rather than Stripe —
# Stripe doesn't support payouts to Nigerian bank accounts, so it was never usable for this
# app's actual merchant. Get these from your Flutterwave Dashboard
# (https://dashboard.flutterwave.com) — use test-mode ("Test" toggle / test API keys) while
# developing, live-mode once ready for real users.
# - FLUTTERWAVE_SECRET_KEY: Settings -> API -> Secret Key.
# - FLUTTERWAVE_PLAN_ID: Settings -> Payment Plans -> create a plan (e.g. "KROFT Plus", a
#   recurring amount/interval/currency), then copy its numeric id.
# - FLUTTERWAVE_WEBHOOK_SECRET_HASH: Settings -> Webhooks -> set a "Secret Hash" (any string
#   you choose — this is a static shared secret, not something Flutterwave generates for you)
#   and point the webhook URL at <your deployed URL>/api/billing/webhook, subscribed to at
#   least charge.completed and subscription.cancelled. Without this correctly configured,
#   ongoing renewals (charged automatically with no browser present) won't be reflected here —
#   the first payment still gets confirmed via api/billing/callback.js's own server-side verify
#   regardless, but only the webhook keeps status in sync afterward.
#
# Flutterwave has no hosted self-serve billing portal the way Stripe does — see
# api/_lib/flutterwave.js and api/billing/cancel.js for how cancellation works instead (a
# direct in-app action, not a redirect to a page Flutterwave hosts).
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PLAN_ID=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
